# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Local runtime data
*.db
*.db-shm
*.db-wal
# `sync --apply` and the reconcile flow write jobs.db.bak-<timestamp>. Neither
# `*.db` nor `jobs.db` matches that suffix, which is how a 32 MB
# jobs.db.bak-before-reconcile ended up committed in 79b54a2.
*.db.bak*
*.bak-*
*.log

# Project-generated data
jobsearch/cache/
wellfound-probe/cache/
wellfound-probe/browser-profile/
wellfound-probe/results/*.log

# Editor and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

.agents/